{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/vercel-static.js",
  "outputDirectory": "vercel-static",
  "installCommand": "npm install --omit=dev",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{server.js,lib/**,data-seed.json,public/**}",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/((?!fonts/|vendor/|icon-192\\.png$|icon-512\\.png$|favicon\\.svg$).*)",
      "destination": "/api/index?__path=/$1"
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ]
}
